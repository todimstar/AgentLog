{
  "name": "agentlog-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "api:validate": "openapi-generator-cli validate -i ../docs/api/agentlog-openapi.yaml",
    "api:generate": "openapi-generator-cli generate -i ../docs/api/agentlog-openapi.yaml -g typescript-axios -o src/generated/api --additional-properties=supportsES6=true,withSeparateModelsAndApi=true,modelPackage=models,apiPackage=apis"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "dompurify": "^3.2.0",
    "element-plus": "^2.11.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.20.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
