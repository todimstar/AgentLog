<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentlog.reliability.infrastructure.persistence.mapper.ErrorReportMapper">

    <update id="linkAttemptToErrorReport">
        UPDATE contribution_attempt
        SET error_report_id = #{errorReportId},
            updated_at      = #{now}
        WHERE id = #{attemptId}
    </update>

</mapper>
