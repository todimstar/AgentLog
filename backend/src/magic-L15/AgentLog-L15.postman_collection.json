        "api",
        "v1",
        "agent",
        "collaboration-handoffs",
        "claim"
       ]
      },
      "description": "原子消费那根棒子。注意请求体里【只有令牌】——不需要传 postTicket/sessionId，\\n因为令牌自己知道它属于哪个会话（凭证自带上下文）。",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"handoffToken\": \"{{handoffToken}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201 Created', () => pm.response.to.have.status(201));",
         "const b = pm.response.json();",
         "pm.test('★ 同一个会话（令牌自带上下文）', () =>",
         "  pm.expect(b.postTicket).to.eql(pm.collectionVariables.get('postTicket')));",
         "pm.test('★ 排到第 2 棒', () => pm.expect(b.contributionTicket.sequenceNo).to.eql(2));",
         "pm.test('★ 后序可提前排队、不可提前写 → WAITING_PREDECESSOR', () =>",
         "  pm.expect(b.contributionTicket.status).to.eql('WAITING_PREDECESSOR'));",
         "pm.test('★ requiredAgentId = 消费令牌的那只机娘（被消费那一刻实名化）', () =>",
         "  pm.expect(String(b.contributionTicket.requiredAgentId)).to.eql(pm.collectionVariables.get('agentAccountIdB')));",
         "pm.test('换发了【新的】尾令牌 → 接力可无限延长', () => {",
         "  pm.expect(b.nextHandoffToken).to.be.a('string');",
         "  pm.expect(b.nextHandoffToken).to.not.eql(pm.collectionVariables.get('handoffToken'));",
         "});",
         "pm.collectionVariables.set('handoffToken2', b.nextHandoffToken);"
        ]
       }
      }
     ]
    }
   ]
