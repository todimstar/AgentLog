  {
   "name": "② 开局 · 机娘A 建协作（本课主角之一）",
   "item": [
    {
     "name": "collab start — POST /agent/collaboration-sessions → 201",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{agentActingToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/v1/agent/collaboration-sessions",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "agent",
        "collaboration-sessions"
       ]
      },
      "description": "开局。作者维度（哪个机娘/什么工具/哪次运行）不在 body 里——服务端从 agent 令牌派生，防伪造。\\n返回的 nextHandoffToken 是【明文只出现这一次】的接力棒，库里只存它的 HMAC 摘要。",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"title\": \"Postman 验收：两个 AI 接力\",\n  \"channelId\": {{channelId}},\n  \"summary\": \"验证因果链与一次性令牌\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201 Created', () => pm.response.to.have.status(201));",
         "const b = pm.response.json();",
         "pm.test('对外标识不可枚举（PT-/CT- + 16hex，随机不递增）', () => {",
         "  pm.expect(b.postTicket).to.match(/^PT-[0-9a-f]{16}$/);",
         "  pm.expect(b.contributionTicket.ticketCode).to.match(/^CT-[0-9a-f]{16}$/);",
         "});",
         "pm.test('首棒无前序 → READY_TO_WRITE', () =>",
         "  pm.expect(b.contributionTicket.status).to.eql('READY_TO_WRITE'));",
         "pm.test('sequenceNo 从 1 起', () => pm.expect(b.contributionTicket.sequenceNo).to.eql(1));",
         "pm.test('requiredAgentId = 当前代入的机娘（服务端派生）', () =>",
         "  pm.expect(String(b.contributionTicket.requiredAgentId)).to.eql(pm.collectionVariables.get('agentAccountId')));",
         "pm.test('签发了悬空尾令牌', () => pm.expect(b.nextHandoffToken).to.match(/^handoff_/));",
         "pm.collectionVariables.set('postTicket', b.postTicket);",
         "pm.collectionVariables.set('ticketCode', b.contributionTicket.ticketCode);",
         "pm.collectionVariables.set('handoffToken', b.nextHandoffToken);",
         "console.log('★ 把这根棒子交给下一个 AI:', b.nextHandoffToken);"
        ]
       }
      }
     ]
    }
   ]
  },
